# Copy these values into your shell session; do not commit real secrets.
# IMAGE_TAG should be the immutable commit SHA pushed by GitHub Actions.
export NAMESPACE="ecommerce"
export IMAGE_REGISTRY="docker.io/your-dockerhub-username"
export IMAGE_TAG="replace-with-git-commit-sha"
export REPLICA_COUNT="1"
# Set these from GitHub Actions Secrets or your local secret manager.
export JWT_SECRET="$(openssl rand -hex 32)"
export STRIPE_SECRET_KEY=""
export GRAFANA_ADMIN_USER="admin"
export GRAFANA_ADMIN_PASSWORD=""
