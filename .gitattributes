# Handle line endings automatically for files detected as text
# and leave all files detected as binary untouched.
* text=auto

# Force LF line endings for all YAML/Shell/CI files
# (Prevents Windows CRLF from causing linter warnings and cross-platform issues)
*.yaml   text eol=lf
*.yml    text eol=lf
*.sh     text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.env    text eol=lf
*.js     text eol=lf
*.jsx    text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.css    text eol=lf
*.html   text eol=lf
*.Dockerfile text eol=lf
Dockerfile   text eol=lf

# Binary files — never touch line endings
*.png    binary
*.jpg    binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.zip    binary
*.gz     binary
